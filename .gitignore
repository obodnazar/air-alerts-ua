# data never goes to git: it is re-downloadable and some of it is large
data/raw/
data/interim/
data/processed/
*.parquet
*.csv
*.jsonl
*.zip
*.pkl

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# local / secrets
.env
.DS_Store

# results are small and are the point of the repo: always track them
!results/
!results/**
!data/snapshot/
!data/snapshot/*.parquet
!data/snapshot/*.json
results/live/bot_*.csv

# bot runtime data: subscriber chat ids and settings (personal data), never in git
data/bot/
.env*
*secrets*.env
worker_secrets.env
.wrangler/
!data/snapshot/*.csv
!data/snapshot/*.gz

# Worker test fixtures (small, no personal data)
!deploy/cloudflare/worker/test/fixtures/*.csv
